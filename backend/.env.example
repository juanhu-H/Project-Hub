APP_NAME=Project Intelligence Hub
APP_ENV=local
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_PATH=./pih.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEMO_ADMIN_EMAIL=admin@pih.local
DEMO_ADMIN_PASSWORD=admin123

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=project = DEMO ORDER BY updated DESC

NEO4J_ENABLED=false
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pih-password

LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Drive (OAuth2, cuenta personal/Workspace) — NO usa cuenta de
# servicio: cada dev necesita su propio Client ID/Secret tipo "Desktop app"
# en Google Cloud Console (con las APIs "Google Drive API" habilitadas), y
# su cuenta de Google agregada como Test user en la pantalla de consentimiento
# OAuth de ese proyecto. Redirect URI a registrar: http://localhost:8765/
DRIVE_FOLDER_ID=
DRIVE_TEST_CASES_FOLDER_ID=

GOOGLE_DRIVE_MCP_ENABLED=true
GOOGLE_DRIVE_MCP_CLIENT_ID=
GOOGLE_DRIVE_MCP_CLIENT_SECRET=
GOOGLE_DRIVE_MCP_SCOPES=https://www.googleapis.com/auth/drive.readonly
GOOGLE_DRIVE_MCP_TOKEN_PATH=./drive_mcp_token.json
GOOGLE_DRIVE_MCP_REDIRECT_PORT=8765
