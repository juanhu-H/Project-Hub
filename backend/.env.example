APP_NAME=Project Intelligence Hub
APP_ENV=local
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_PATH=./pih.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEMO_ADMIN_EMAIL=admin@pih.local
DEMO_ADMIN_PASSWORD=admin123

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=project = DEMO ORDER BY updated DESC

NEO4J_ENABLED=false
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pih-password

LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Drive MCP (la cuenta de servicio debe tener acceso a los archivos o
# carpetas de Drive que se quieran consultar).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_DRIVE_MCP_ENABLED=true
GOOGLE_DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1
